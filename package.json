{
  "name": "room-social-check-in",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/validate-project.mjs",
    "test": "node scripts/test-health.mjs && node scripts/test-sleep-shield.mjs && node scripts/test-sleep-context.mjs && node scripts/test-platform-scale.mjs && node scripts/test-platform-removal.mjs && node scripts/test-tools-state.mjs && node scripts/test-next-steps.mjs && node scripts/test-age.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare-build",
    "screenshots": "node scripts/capture-showcase.mjs",
    "test:routing": "node scripts/test-routing-worker.mjs && node scripts/test-routing.mjs",
    "test:motion": "node scripts/test-motion.mjs",
    "test:age": "node scripts/test-age-browser.mjs"
  },
  "dependencies": {
    "openai": "7.28.0"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.149.0"
  }
}
