{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-media-sense",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {},
  "keep_vars": true
}
